{
  "name": "opendata-communes",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "import:geo": "tsx scripts/import-geo.ts",
    "import:ofgl": "tsx scripts/import-ofgl.ts",
    "import:annuaire": "tsx scripts/import-annuaire.ts",
    "import:all": "npm run import:geo && npm run import:ofgl && npm run import:annuaire",
    "postinstall": "prisma generate",
    "import:documents": "tsx scripts/import-documents.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.6.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "dotenv": "18.0.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  },
  "overrides": {
    "effect": "3.22.5",
    "nodemailer": "10.6.1"
  }
}
