# ── Identité de la plateforme (mentions légales, LCEN) ──
SITE_NAME="Nom de la plateforme"
SITE_URL="https://exemple.fr"
ASSO_NOM="Nom de l'association"
ASSO_SIREN="000000000"
ASSO_RNA="W000000000"
ASSO_ADRESSE="Adresse du siège"
ASSO_EMAIL="contact@exemple.fr"
DIRECTEUR_PUBLICATION="Prénom Nom"
HEBERGEUR="Nom, adresse et téléphone de l'hébergeur"

# ── Réseau : adresse et port d'écoute du site, vus par le reverse proxy ──
APP_ECOUTE="127.0.0.1:8087"

# ── Périmètre ──
# Départements couverts (codes INSEE séparés par des virgules)
DEPARTEMENTS_ACTIFS="11"

# ── Base de données ──
POSTGRES_USER=opendata
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=opendata
# Depuis l'hôte (dev) : localhost:5433 · depuis les conteneurs : db:5432
DATABASE_URL="postgresql://opendata:change-moi@localhost:5433/opendata"

# ── Stockage des documents ──
STORAGE_DIR="./storage"
# Clé AES-256 (64 caractères hexadécimaux) pour chiffrer les originaux non occultés.
# Générer avec : openssl rand -hex 32   — À SAUVEGARDER HORS DU SERVEUR.
ORIGINALS_KEY=""

# ── Accès HTTP Basic : développement uniquement, inactif sans ADMIN_BASIC=1 ──
# ADMIN_BASIC="1"
# ADMIN_USER="admin"
# ADMIN_PASSWORD=""   # openssl rand -base64 30

# ── Rôle de base limité aux données (app et workers) ; les migrations utilisent POSTGRES_USER ──
POSTGRES_APP_PASSWORD=""   # openssl rand -hex 24

# ── Mentions légales et code source ──
ASSO_TELEPHONE=""      # obligatoire pour une personne morale (LCEN)
SOURCE_URL=""          # dépôt public du code (AGPL)

# ── Supervision (facultatif) : moniteur « push » Uptime Kuma ──
KUMA_PUSH_URL=""

# ── Connexion administrateur : Authentik (OIDC) ──
# Sans ces variables, l'administration est fermée (sauf ADMIN_BASIC=1). Groupe requis : AUTH_ADMIN_GROUP (obligatoire).
AUTH_URL="https://exemple.fr"
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_AUTHENTIK_ID=""
AUTH_AUTHENTIK_SECRET=""
AUTH_AUTHENTIK_ISSUER="https://authentik.exemple.fr/application/o/<slug>/"
AUTH_ADMIN_GROUP="lpgl-admins"

# ── Envoi des demandes (SMTP) ──
SMTP_HOST="smtp-relay.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="demandes@exemple.fr"
SMTP_FROM_NAME="Nom de la plateforme"
SMTP_EHLO="exemple.fr"
