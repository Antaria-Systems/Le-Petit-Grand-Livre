// Schéma de données de la plateforme.
// Trois blocs : référentiel géographique + finances (open data),
// documents obtenus par demande CRPA (avec occultation), suivi des demandes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Référentiel géographique ─────────────────────────────

model Region {
  code         String        @id
  nom          String
  departements Departement[]
}

model Departement {
  code       String    @id
  nom        String
  regionCode String
  region     Region    @relation(fields: [regionCode], references: [code])
  // Département couvert par la plateforme (communes importées, demandes envoyées)
  actif      Boolean   @default(false)
  // Cadre de la carte du département (« 0 0 largeur hauteur »), dans lequel sont tracées les communes
  carteViewBox String?
  communes   Commune[]

  @@index([regionCode])
}

model Commune {
  code            String      @id // code INSEE
  nom             String
  // nom normalisé (minuscules, sans accents ni tirets) pour la recherche
  nomRecherche    String
  slug            String      @unique // ex. "lavalette-11199" (plusieurs Lavalette en France)
  departementCode String
  departement     Departement @relation(fields: [departementCode], references: [code])
  population      Int?
  codesPostaux    String[]
  siren           String?
  epciNom         String?
  // Strate de population OFGL (0 = moins de 100 hab. … 10 = 100 000 hab. et plus)
  strate          Int?
  // Contour simplifié (chemin SVG) dans le cadre de la carte du département
  cheminCarte     String?

  // Saisis dans l'administration
  presentation    String? // texte public affiché sur la fiche (contexte, précisions)
  notesInternes   String? // jamais publié

  // Contact de la mairie (Annuaire de l'administration, service-public.fr)
  mairieEmail     String?
  mairieTelephone String?
  mairieAdresse   String?
  mairieSite      String?

  agregats   AgregatFinancier[]
  indemnites IndemniteFonction[]
  frais      FraisFonction[]
  operations Operation[]
  documents  Document[]
  demandes   Demande[]

  majLe DateTime @updatedAt

  @@index([departementCode])
  @@index([nomRecherche])
}

// ───────────────────────────── Finances (open data OFGL) ─────────────────────────────

// Un agrégat comptable OFGL pour une commune, un exercice et un type de budget.
model AgregatFinancier {
  id           Int     @id @default(autoincrement())
  communeCode  String
  commune      Commune @relation(fields: [communeCode], references: [code], onDelete: Cascade)
  exercice     Int
  agregat      String
  typeBudget   String // "Budget principal" | "Budget annexe"
  montant      Float
  parHabitant  Float?

  @@unique([communeCode, exercice, agregat, typeBudget])
  @@index([communeCode, exercice])
}

// Médiane nationale par strate de population, pour comparer une commune à ses pairs.
model ReferenceStrate {
  id                Int    @id @default(autoincrement())
  exercice          Int
  strate            Int
  agregat           String
  medianeParHabitant Float
  moyenneParHabitant Float
  nbCommunes        Int

  @@unique([exercice, strate, agregat])
}

// ───────────────────────────── Données issues des documents CRPA ─────────────────────────────

// Indemnités des élus, publiées PAR FONCTION uniquement (jamais nominatives).
model IndemniteFonction {
  id               Int       @id @default(autoincrement())
  communeCode      String
  commune          Commune   @relation(fields: [communeCode], references: [code], onDelete: Cascade)
  annee            Int
  fonction         String // "Maire", "1er adjoint", "Conseiller délégué"…
  ordre            Int       @default(0) // tri d'affichage
  montantBrutAnnuel Decimal  @db.Decimal(12, 2)
  documentId       String?
  document         Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([communeCode, annee])
}

// Frais (déplacements, représentation, formation…) rattachés à une fonction.
model FraisFonction {
  id          Int       @id @default(autoincrement())
  communeCode String
  commune     Commune   @relation(fields: [communeCode], references: [code], onDelete: Cascade)
  annee       Int
  fonction    String
  nature      String // "Déplacement", "Représentation", "Formation"…
  libelle     String?
  date        DateTime? @db.Date
  montant     Decimal   @db.Decimal(12, 2)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([communeCode, annee])
}

// Chantier ou opération : regroupe délibérations, devis, bons de commande et factures.
model Operation {
  id          Int             @id @default(autoincrement())
  communeCode String
  commune     Commune         @relation(fields: [communeCode], references: [code], onDelete: Cascade)
  slug        String
  intitule    String
  categorie   String? // "Voirie", "Bâtiments scolaires"…
  lieu        String?
  description String?
  annee       Int?
  date        DateTime?       @db.Date
  // Montant voté ou commandé (délibération, bons de commande), quand il est connu
  montantHT   Decimal?        @db.Decimal(14, 2)
  montantTTC  Decimal?        @db.Decimal(14, 2)
  prestataire String? // personnes morales ou noms commerciaux
  statut      StatutOperation @default(REALISEE)
  documents   Document[]

  @@unique([communeCode, slug])
  @@index([communeCode, annee])
}

enum StatutOperation {
  PREVUE
  EN_COURS
  REALISEE
}

// ───────────────────────────── Documents & occultation ─────────────────────────────

model Document {
  id          String            @id @default(cuid())
  communeCode String
  commune     Commune           @relation(fields: [communeCode], references: [code], onDelete: Cascade)
  titre       String
  categorie   CategorieDocument
  annee       Int?
  dateDocument DateTime?        @db.Date
  statut      StatutDocument    @default(RECU)

  // Fichier original NON occulté : chiffré (AES-256-GCM), hors du stockage public.
  nomOriginal      String
  cheminChiffre    String
  sha256Original   String
  typeMime         String
  nbPages          Int?

  // Version occultée, rendue en images puis réassemblée en PDF (aucun texte caché).
  cheminPublic     String?
  sha256Public     String?

  // Informations relevées sur le document (affichées sur la fiche commune)
  entreprise  String?
  objet       String?
  montantHT   Decimal?          @db.Decimal(14, 2)
  // Facture : montant payé (net à payer) · devis / bon de commande / délibération : montant total
  montantTTC  Decimal?          @db.Decimal(14, 2)
  // Second exemplaire d'un document déjà présent : exclu des totaux
  copie       Boolean           @default(false)
  operationId Int?
  operation   Operation?        @relation(fields: [operationId], references: [id], onDelete: SetNull)

  demandeId   String?
  demande     Demande?          @relation(fields: [demandeId], references: [id], onDelete: SetNull)
  messageId   String?
  message     Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)

  notes       String?
  // Lot d'import (nom du dossier ou de l'archive d'origine)
  lot         String?
  // Travail en attente pour le worker, et dernière erreur éventuelle
  travail     TravailDocument?
  erreur      String?
  // « Terminer » dans l'éditeur : publier dès que la version occultée est générée
  publierApresGeneration Boolean @default(false)
  pages       PageDocument[]
  zones       ZoneOccultation[]
  indemnites  IndemniteFonction[]
  frais       FraisFonction[]

  recuLe      DateTime          @default(now())
  publieLe    DateTime?
  majLe       DateTime          @updatedAt

  @@index([communeCode, statut])
  @@index([travail])
  @@unique([communeCode, sha256Original])
}

enum TravailDocument {
  ANALYSER  // rendu des pages + OCR + détection automatique des zones
  GENERER   // application des zones validées + PDF public
}

// Aperçu d'une page (image non occultée, CHIFFRÉE) pour l'interface de validation.
model PageDocument {
  id         Int      @id @default(autoincrement())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  numero     Int // à partir de 1
  largeur    Int // pixels de l'aperçu
  hauteur    Int
  cheminChiffre String

  @@unique([documentId, numero])
}

enum CategorieDocument {
  BUDGET
  COMPTE_ADMINISTRATIF
  DELIBERATION
  INDEMNITES
  FRAIS
  DEVIS
  BON_DE_COMMANDE
  FACTURE
  MARCHE
  SUBVENTION
  TRAVAUX
  AUTRE
}

enum StatutDocument {
  RECU            // original chiffré, pas encore analysé
  EN_ANALYSE      // traitement en cours par le worker
  A_VERIFIER      // zones détectées automatiquement, en attente de validation
  OCCULTE         // occultation validée, version publique générée
  PUBLIE          // visible sur la plateforme
  NON_PUBLIABLE   // conservé mais jamais publié
}

// Zone à masquer, en coordonnées relatives à la page (0 → 1).
// Le texte détecté n'est jamais stocké : seulement son type.
model ZoneOccultation {
  id         String          @id @default(cuid())
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page       Int
  x          Float
  y          Float
  largeur    Float
  hauteur    Float
  motif      MotifOccultation
  source     SourceZone
  validee    Boolean         @default(false)
  creeeLe    DateTime        @default(now())

  @@index([documentId, page])
}

// Motifs alignés sur les secrets protégés de l'article L.311-6 du CRPA.
enum MotifOccultation {
  DONNEES_BANCAIRES   // IBAN, RIB, BIC
  COORDONNEES_PERSO   // adresse, téléphone, mail personnels
  SIGNATURE
  VIE_PRIVEE          // L.311-6 1°
  APPRECIATION_PERSONNE // L.311-6 2°
  SECRET_AFFAIRES     // L.311-6 1° (secret des affaires)
  AUTRE
}

enum SourceZone {
  AUTO
  MANUEL
}

// ───────────────────────────── Demandes CRPA ─────────────────────────────

model Demande {
  id            String        @id @default(cuid())
  communeCode   String
  commune       Commune       @relation(fields: [communeCode], references: [code], onDelete: Cascade)
  annee         Int // année de campagne (une demande groupée par commune et par an)
  objet         String
  corps         String
  destinataire  String
  statut        StatutDemande @default(BROUILLON)

  envoyeeLe     DateTime?
  // Silence d'un mois = refus implicite (R.311-13)
  echeanceReponse DateTime?
  relanceeLe    DateTime?
  // Saisine de la CADA possible dans les deux mois suivant le refus (R.343-1)
  limiteSaisineCada DateTime?
  cadaSaisieLe  DateTime?
  numeroCada    String?
  avisCadaLe    DateTime?
  avisCada      String? // « favorable », « défavorable », « sans objet »…
  reponseLe     DateTime? // première réponse de l'administration
  clotureLe     DateTime?
  notes         String? // notes internes

  messages  Message[]
  documents Document[]

  creeeLe DateTime @default(now())
  majLe   DateTime @updatedAt

  @@unique([communeCode, annee])
  @@index([statut])
}

enum StatutDemande {
  BROUILLON
  ENVOYEE
  RELANCEE
  REFUS_IMPLICITE
  REFUS_EXPRES
  CADA_SAISIE
  REPONSE_PARTIELLE
  SATISFAITE
  ABANDONNEE
}

model Message {
  id         String     @id @default(cuid())
  demandeId  String
  demande    Demande    @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  sens       SensMessage
  de         String
  a          String
  sujet      String
  corps      String
  date       DateTime
  messageIdEmail String? @unique // en-tête Message-ID, pour rattacher les réponses
  documents  Document[]

  @@index([demandeId, date])
}

enum SensMessage {
  SORTANT
  ENTRANT
}

// Tâches de fond lancées depuis l'administration (import d'un département…), exécutées par le worker.
model Tache {
  id        Int         @id @default(autoincrement())
  type      TypeTache
  parametre String
  statut    StatutTache @default(EN_ATTENTE)
  journal   String      @default("")
  creeLe    DateTime    @default(now())
  debutLe   DateTime?
  finLe     DateTime?

  @@index([statut])
}

enum TypeTache {
  IMPORTER_DEPARTEMENT
}

enum StatutTache {
  EN_ATTENTE
  EN_COURS
  TERMINEE
  ERREUR
}
